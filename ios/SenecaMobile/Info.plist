<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What the generated Info.plist (INFOPLIST_KEY_* in project.yml) cannot
	     say. Xcode merges the two. Audio: a spoken reflection keeps recording
	     when the screen locks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Practice packs: a .seneca-pack.json opened from AirDrop, Files, Mail,
	     or a link. iOS types files by their last extension, so Seneca offers
	     to open JSON, as an alternate handler, and the engine refuses any
	     that is not a pack. The file is copied in, never edited in place. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Seneca Practice Pack</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
